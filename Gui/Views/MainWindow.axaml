<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="https://github.com/avaloniaui/designer"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Modpack_Installer.Gui.Views.MainWindow"
        Title="Minecraft Modpack Installer"
        Width="520" Height="520"
        CanResize="False"
        Background="#1e1e1e"
        Foreground="White">

	<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="20">

		<TextBlock Text="Modpack (URL, Modrinth link or slug, or local .zip/.mrpack):" FontSize="14" Grid.Row="0" Margin="0,0,0,4"/>
		<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
			<TextBox Grid.Column="0"
			         Text="{Binding Source, Mode=TwoWay}"
			         IsEnabled="{Binding IsNotDownloading}"
			         Foreground="White"
			         Background="#2b2b2b"
			         BorderBrush="#555"
			         Watermark="https://example.com/modpack.zip" />
			<Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..."
			        Command="{Binding BrowseCommand}"
			        IsEnabled="{Binding IsNotDownloading}"
			        Foreground="White" Background="#3a3a3a" />
		</Grid>
		<TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="12" Foreground="#9a9a9a"
		           Text="{Binding SourceHint}" />

		<StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,12,0,0" VerticalAlignment="Center">
			<TextBlock Text="Backup current mods folder?" VerticalAlignment="Center" />
			<ToggleSwitch IsChecked="{Binding BackupMods}" IsEnabled="{Binding IsNotDownloading}" Margin="12,0,0,0" />
		</StackPanel>

		<StackPanel Orientation="Horizontal" Grid.Row="4" Margin="0,4,0,0" VerticalAlignment="Center">
			<TextBlock Text="Existing config files:" VerticalAlignment="Center" />
			<ComboBox SelectedIndex="{Binding ConfigPolicyIndex}" IsEnabled="{Binding IsNotDownloading}" Margin="12,0,0,0" MinWidth="220">
				<ComboBoxItem Content="Backup, then overwrite" />
				<ComboBoxItem Content="Overwrite" />
				<ComboBoxItem Content="Keep existing" />
			</ComboBox>
		</StackPanel>

		<TextBlock Grid.Row="5" Margin="0,16,0,0"
		           TextWrapping="Wrap"
		           Foreground="#ff6666"
		           FontSize="12"
		           Text="⚠ Only install modpacks from trusted sources. We do not provide any warranty when using this program. options.txt and servers.dat are never overwritten." />

		<TextBlock Text="{Binding StatusMessage}" FontSize="12" Grid.Row="6" HorizontalAlignment="Center" TextWrapping="Wrap"/>

		<ProgressBar Grid.Row="7" Minimum="0" Maximum="100" Value="{Binding Progress}" ShowProgressText="True" Margin="0,8,0,0"/>

		<StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="10">
			<Button x:Name="InstallButton" Command="{Binding InstallCommand}" IsEnabled="{Binding IsNotDownloading}" Content="Install" Foreground="White" Width="150" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#007acc"/>
			<Button x:Name="CancelButton" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" Content="Cancel" Foreground="White" Width="100" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="#8b2b2b"/>
		</StackPanel>

		<TextBlock Text="Tip: you can also drag a .zip or .mrpack file onto this window. Licensed under the MIT license." FontSize="12" Grid.Row="9" Margin="0,10,0,0" TextWrapping="Wrap"/>

	</Grid>
</Window>
